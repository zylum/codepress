#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The version has ONE source: the codepress-version marker in the bundled
# .codepress/system/codepress.md. Bump it there; nothing else carries a copy.
VERSION="$(sed -n 's/^codepress-version: *//p' "$SCRIPT_DIR/.codepress/system/codepress.md" 2>/dev/null | head -1 || true)"
VERSION="${VERSION:-unknown}"
SOURCE_REPO="https://github.com/zylum/codepress"
CONFIG_FILE=".codepress/system/codepress.md"

# Fallback: some projects use config.md instead of codepress.md
resolve_config() {
  if [[ -f ".codepress/system/codepress.md" ]]; then
    echo ".codepress/system/codepress.md"
  elif [[ -f ".codepress/system/config.md" ]]; then
    echo ".codepress/system/config.md"
  else
    echo "$CONFIG_FILE"
  fi
}

get_codepress_version() {
  local cfg
  cfg=$(resolve_config)
  if [[ -f "$cfg" ]]; then
    grep -m1 "^codepress-version:" "$cfg" 2>/dev/null | sed 's/codepress-version: *//' || echo "0.0.0"
  else
    echo "0.0.0"
  fi
}

get_codepress_source() {
  local cfg
  cfg=$(resolve_config)
  if [[ -f "$cfg" ]]; then
    grep -m1 "^codepress-source:" "$cfg" 2>/dev/null | sed 's/codepress-source: *//' || echo "$SOURCE_REPO"
  else
    echo "$SOURCE_REPO"
  fi
}

# ─── Lifecycle plumbing (lint.py) ─────────────────────────────────────────────
#
# Statuses, transitions, gates and the legacy mapping live in
# .codepress/system/schema/lifecycle.yaml and are read by lib/lint.py. The CLI
# asks lint.py rather than keeping its own copy of the rules.

# Path to lint.py: the project's own copy first, else the bundled one.
find_lint() {
  if [[ -f ".codepress/system/lib/lint.py" ]]; then
    echo ".codepress/system/lib/lint.py"
  elif [[ -f "$SCRIPT_DIR/.codepress/system/lib/lint.py" ]]; then
    echo "$SCRIPT_DIR/.codepress/system/lib/lint.py"
  else
    return 1
  fi
}

# run_lint_py <args...> — python3 lint.py with a clear error when it cannot run.
run_lint_py() {
  local py
  if ! command -v python3 >/dev/null 2>&1; then
    echo "✗ python3 is required for lint and lifecycle gates (standard library only, 3.8+)." >&2
    return 2
  fi
  if ! py=$(find_lint); then
    echo "✗ lint.py not found. Run 'codepress upgrade' to install .codepress/system/lib/." >&2
    return 2
  fi
  python3 "$py" "$@"
}

# Status table (kind status canonical flags), loaded once per process.
_STATUS_TABLE=""
_STATUS_TABLE_LOADED=false
load_status_table() {
  [[ "$_STATUS_TABLE_LOADED" == true ]] && return 0
  _STATUS_TABLE_LOADED=true
  _STATUS_TABLE=$(run_lint_py table 2>/dev/null || true)
}

# canon_status <galley|slug> <status> — sets CANON_STATUS and CANON_FLAGS.
# Unknown values (or no python3) resolve to themselves with empty flags, so the
# legacy vocabulary keeps working where lint.py cannot be consulted.
CANON_STATUS=""
CANON_FLAGS=""
CANON_KNOWN=false
canon_status() {
  local kind="$1" raw="$2" row
  load_status_table
  row=$(printf '%s\n' "$_STATUS_TABLE" | awk -v k="$kind" -v s="$raw" '$1 == k && $2 == s { print $3, $4; exit }')
  if [[ -n "$row" ]]; then
    CANON_STATUS="${row%% *}"
    CANON_FLAGS="${row#* }"
    CANON_KNOWN=true
  else
    CANON_STATUS="$raw"
    CANON_FLAGS=""
    CANON_KNOWN=false
  fi
}

# Quote a value for frontmatter when it contains YAML-significant characters.
yaml_value() {
  local v="$1"
  if [[ "$v" =~ [:#\[\]\{\}] || "$v" == \"* || "$v" == \'* ]]; then
    v="${v//\"/\'}"
    printf '"%s"' "$v"
  else
    printf '%s' "$v"
  fi
}

# Set (or add) a frontmatter key in a markdown file.
set_fm_field() {
  local file="$1" key="$2" value="$3" tmp
  tmp=$(mktemp)
  awk -v k="$key" -v v="$value" '
    NR == 1 && /^---[ \t]*$/ { print; infm = 1; next }
    infm && /^---[ \t]*$/ { if (!done) print k ": " v; infm = 0; print; next }
    infm && $0 ~ ("^" k ":") { print k ": " v; done = 1; next }
    { print }
  ' "$file" > "$tmp" && cat "$tmp" > "$file"
  rm -f "$tmp"
}

# Rewrite the codepress-version marker line in a file (BSD/GNU sed safe).
set_marker() {
  local file="$1" ver="$2" tmp
  tmp=$(mktemp)
  awk -v v="$ver" '/^codepress-version:/ && !done { print "codepress-version: " v; done = 1; next } { print }' "$file" > "$tmp" \
    && cat "$tmp" > "$file"
  rm -f "$tmp"
}

# Value of a frontmatter key ("" when absent).
get_fm_field() {
  local file="$1" key="$2"
  awk -v k="$key" '
    NR == 1 && /^---[ \t]*$/ { infm = 1; next }
    infm && /^---[ \t]*$/ { exit }
    infm && $0 ~ ("^" k ":") { sub("^" k ":[ \t]*", ""); sub(/[ \t]+#.*$/, ""); sub(/[ \t]+$/, ""); print; exit }
  ' "$file"
}

usage() {
  cat <<EOF
CodePress v$VERSION — compound product development operating system.

Usage:
  codepress init                  Bootstrap CodePress in this directory
  codepress bootstrap             Configure project (verification, DoD, etc.)
  codepress upgrade               Update .codepress/system/ files from source
  codepress migrate               Migrate from old numbered structure
  codepress status [--json]       Show project health and pending actions
                                  [--json --galleys] per-galley state: slugs, activity, next action
  codepress run [--all]           Execute next pending action (or all)
  codepress watch [seconds]       Watch artefact dir and auto-execute (default 2s)

  codepress galley new <name>     Scaffold a new galley
  codepress galley list           List all galleys with status
  codepress galley move <n> <s>   Set galley status
                                  lifecycle: proposed → shaped → building → verifying → done
                                             (or killed / superseded from any open status)
                                  Allowed edges and their gates come from
                                  .codepress/system/schema/lifecycle.yaml.
                                  [--force] bypasses gates, recording a waiver in review.md
                                  [--reason <text>] recorded with the waiver / as closed_reason
                                  [--superseded-by <galley>] for superseded
                                  (galleys still on retired statuses keep the old gates:
                                   shaping|approved|delivering|review|done)
  codepress galley approve <n>    Record human approval of a shaped galley [--by <who>]
  codepress check <galley>        Run verify gates fresh + evaluate every bound AC
                                  (test:/check:/manual: lines — see templates/galley.md)
  codepress lint [--base REF]     Check statuses, transitions, gates, drift, version marker
