}

# ─── System file population (shared by init + migrate) ────────────────────────

# Populate .codepress/system/ with canonical files — from bundled SCRIPT_DIR
# if available, else by cloning the source repo. Returns nonzero on failure.
populate_system_files() {
  if [[ -d "$SCRIPT_DIR/.codepress/system" ]]; then
    echo "→ Copying system files (bundled)..."
    cp -r "$SCRIPT_DIR/.codepress/system/." .codepress/system/
    return 0
  fi

  local src tmp
  src=$(get_codepress_source)
  tmp=$(mktemp -d)
  echo "→ Fetching system files from $src..."
  if git clone --depth 1 --quiet "$src" "$tmp/repo" 2>/dev/null && [[ -d "$tmp/repo/.codepress/system" ]]; then
    cp -r "$tmp/repo/.codepress/system/." .codepress/system/
    rm -rf "$tmp"
    return 0
  fi

  echo "✗ Could not fetch from $src"
  echo "  Clone the repo manually: git clone $src"
  rm -rf "$tmp"
  return 1
}

# ─── Init ────────────────────────────────────────────────────────────────────

cmd_init() {
  echo "CodePress init v$VERSION"
  echo ""

  if [[ -d ".codepress/system" ]]; then
    local v
    v=$(get_codepress_version)
    echo "→ CodePress v$v already bootstrapped here (.codepress/system/ exists)."
    echo "  Run 'codepress upgrade' to update .codepress/system/ files."
    echo "  Run 'codepress migrate' if upgrading from an older structure."
    exit 0
  fi

  echo "→ Bootstrapping CodePress structure..."

  mkdir -p .codepress/system/{skills,templates,hooks}
  mkdir -p .codepress/product/{initiatives,galleys,releases}
  mkdir -p .codepress/knowledge/{decisions,signals,patterns}
  mkdir -p .codepress/views docs tests
  mkdir -p .claude/commands

  cat > AGENTS.md << 'EOF'
# CodePress

See `.codepress/system/AGENTS.md` for the full operating manual.
EOF

  populate_system_files || exit 1

  echo ""
  echo "✓ CodePress v$VERSION bootstrapped."
  echo ""
  echo "Next steps:"
  echo "  1. Run 'codepress bootstrap' to configure your project"
  echo "  2. Or manually edit .codepress/system/codepress.md"
  echo ""
  echo "The bootstrap process will:"
  echo "  - Detect your project type (Python, TypeScript, etc.)"
  echo "  - Configure verification commands"
  echo "  - Define your Definition of Done"
  echo "  - Set up working style and team roles"
  echo "  - Run a verification dry run"
}

# ─── Bootstrap ────────────────────────────────────────────────────────────────

cmd_bootstrap() {
  echo "CodePress bootstrap v$VERSION"
  echo ""

  if [[ ! -d ".codepress/system" ]]; then
    echo "✗ Not a CodePress project (.codepress/system/ not found)."
    echo "  Run 'codepress init' first."
    exit 1
  fi

  # Check if bootstrap already completed
  if [[ -f ".codepress/system/manifest.md" ]]; then
    echo "→ Project already bootstrapped (manifest.md exists)."
    echo "  To re-bootstrap, delete .codepress/system/manifest.md and run again."
    exit 0
  fi

  echo "→ Starting project bootstrap..."
  echo ""
  echo "This process will:"
  echo "  1. Detect your project type"
  echo "  2. Configure verification commands"
  echo "  3. Define your Definition of Done"
  echo "  4. Set up working style and team roles"
  echo "  5. Run a verification dry run"
  echo ""
  echo "For interactive setup, run: codepress bootstrap --interactive"
  echo "For defaults, run: codepress bootstrap --defaults"
  echo ""

  # For now, just show the manual process
  echo "To bootstrap manually:"
  echo "  1. Edit .codepress/system/codepress.md with your project config"
  echo "  2. Edit .codepress/system/dod.md with your Definition of Done"
  echo "  3. Run verification commands to ensure they work"
  echo "  4. Create .codepress/system/manifest.md with project identity"
}

# ─── Utils ─────────────────────────────────────────────────────────────────────

# Merge YAML frontmatter from system file into local file.
# Adds any frontmatter keys present in system that are missing in local.
# Preserves all local content including existing frontmatter values.
merge_frontmatter() {
  local local_file="$1"
  local system_file="$2"
  local lines=() line i key lk sys_key found tmp

  [[ ! -f "$local_file" || ! -f "$system_file" ]] && return

  while IFS= read -r line; do lines+=("$line"); done < "$local_file"

  local fm_start=-1 fm_end=-1 count=0
  for ((i = 0; i < ${#lines[@]}; i++)); do
    [[ "${lines[$i]}" == "---" ]] && { count=$((count + 1)); [[ $count -eq 1 ]] && fm_start=$i; [[ $count -eq 2 ]] && { fm_end=$i; break; }; }
  done
  [[ $fm_end -eq -1 ]] && return

  local local_keys=()
  for ((i = fm_start + 1; i < fm_end; i++)); do
    line="${lines[$i]}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    local_keys+=("${line%%:*}")
  done

  local sys_keys=()
  local in_fm=0
  while IFS= read -r line; do
    [[ "$line" == "---" ]] && { in_fm=$((in_fm + 1)); continue; }
    [[ "$in_fm" -ge 2 ]] && break
    [[ "$in_fm" -eq 1 && -n "$line" && "$line" != \#* ]] && sys_keys+=("$line")
  done < "$system_file"

  [[ ${#sys_keys[@]} -eq 0 ]] && return

  local to_insert=()
  for sys_line in "${sys_keys[@]}"; do
    sys_key="${sys_line%%:*}"
    found=0
    for lk in "${local_keys[@]}"; do
      [[ "$lk" == "$sys_key" ]] && { found=1; break; }
    done
    [[ $found -eq 0 ]] && to_insert+=("$sys_line")
  done

  [[ ${#to_insert[@]} -eq 0 ]] && return

  tmp=$(mktemp)
  {
    for ((i = 0; i < fm_end; i++)); do echo "${lines[$i]}"; done
    for insert in "${to_insert[@]}"; do echo "$insert"; done
    for ((i = fm_end; i < ${#lines[@]}; i++)); do echo "${lines[$i]}"; done
  } > "$tmp"
  mv "$tmp" "$local_file"
  echo "    M  $local_file (frontmatter merged)"
}

# ─── Upgrade ──────────────────────────────────────────────────────────────────

cmd_upgrade() {
  local current
  current=$(get_codepress_version)
  echo "CodePress upgrade v$current → latest"
  echo ""

  if [[ ! -d ".codepress/system" ]]; then
    echo "✗ Not a CodePress project (.codepress/system/ not found). Run 'codepress init' first."
    exit 1
  fi

  local tmp
  tmp=$(mktemp -d)
  trap "rm -rf '$tmp'" EXIT

  local src
  src=$(get_codepress_source)
  echo "→ Fetching CodePress source from $src..."
  if ! git clone --depth 1 --quiet "$src" "$tmp/repo" 2>/dev/null; then
    echo "✗ Could not fetch source. Check your internet connection."
    exit 1
  fi

  local latest
  if [[ -f "$tmp/repo/.codepress/system/codepress.md" ]]; then
    latest=$(grep -m1 "^codepress-version:" "$tmp/repo/.codepress/system/codepress.md" 2>/dev/null | sed 's/codepress-version: *//' || echo "0.0.0")
  else
    echo "✗ No .codepress/system/ found in source repo."
    exit 1
  fi

  echo "→ Current: v$current  Latest: v$latest"
  echo ""

  if [[ "$current" == "$latest" ]]; then
    echo "✓ Already up to date."
    return
  fi

  # Collect all system files from the source repo
  local sys_files=()
  while IFS= read -r f; do sys_files+=("$f"); done < <(cd "$tmp/repo" && find .codepress/system -type f | sed 's|^\./||')

  # ── Phase 1: Analyse ──
  local to_add=() to_update=() to_merge=()
  local local_mods=0

  for f in "${sys_files[@]}"; do
    local target="$f"
    local source="$tmp/repo/$f"
    if [[ ! -f "$target" ]]; then
      to_add+=("$f")
    elif [[ "$f" == ".codepress/system/codepress.md" ]]; then
      # Project-owned configuration: never overwritten, only its version marker moves.
      continue
    elif ! diff -q "$target" "$source" &>/dev/null; then
      if [[ "$f" == *templates/* ]]; then
        to_merge+=("$f")
      else
        to_update+=("$f")
      fi
    fi
  done

  echo "→ Changes:"
  if [[ ${#to_add[@]} -gt 0 ]]; then
    for f in "${to_add[@]}"; do echo "    +  $f"; done
  fi
  if [[ ${#to_update[@]} -gt 0 ]]; then
    for f in "${to_update[@]}"; do echo "    U  $f"; done
  fi
  if [[ ${#to_merge[@]} -gt 0 ]]; then
    for f in "${to_merge[@]}"; do echo "    ~  $f (frontmatter merge)"; done
  fi

  if [[ ${#to_add[@]} -eq 0 && ${#to_update[@]} -eq 0 && ${#to_merge[@]} -eq 0 ]]; then
    echo "  (no files to change — only the version marker moves)"
  fi

  # ── Phase 2: Apply ──
  echo ""
  read -p "  Apply update? [y/N] " confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "  Aborted."
    return
  fi

  local copied=0 merged=0
  if [[ ${#to_add[@]} -gt 0 ]]; then
    for f in "${to_add[@]}"; do
      mkdir -p "$(dirname "$f")"
      cp "$tmp/repo/$f" "$f"
      copied=$((copied + 1))
    done
  fi
  if [[ ${#to_update[@]} -gt 0 ]]; then
    for f in "${to_update[@]}"; do
      mkdir -p "$(dirname "$f")"
      cp "$tmp/repo/$f" "$f"
      copied=$((copied + 1))
    done
  fi
  if [[ ${#to_merge[@]} -gt 0 ]]; then
    for f in "${to_merge[@]}"; do
      merge_frontmatter "$f" "$tmp/repo/$f" && merged=$((merged + 1))
    done
  fi

  # ── Phase 3: Sync product templates ──
  local sys_templates_dir="$tmp/repo/.codepress/system/templates"
  local product_templates_dir=".codepress/product/templates"
  if [[ -d "$sys_templates_dir" ]]; then
    mkdir -p "$product_templates_dir"
    while IFS= read -r t; do
      local tname="${t#$sys_templates_dir/}"
      local product_target="$product_templates_dir/$tname"
      if [[ -f "$product_target" ]]; then
        merge_frontmatter "$product_target" "$t" && merged=$((merged + 1))
      else
        mkdir -p "$(dirname "$product_target")"
        cp "$t" "$product_target"
        echo "    +  .codepress/product/templates/$tname"
        copied=$((copied + 1))
      fi
    done < <(find "$sys_templates_dir" -type f)
  fi

  # One source of truth: the marker lives in codepress.md. Bump it there — and
  # in any leftover config file that still carries one, so they cannot disagree.
  local mf
  for mf in .codepress/system/*.md; do
    [[ -f "$mf" ]] || continue
    if grep -q '^codepress-version:' "$mf" 2>/dev/null; then
      set_marker "$mf" "$latest"
    fi
  done

  echo ""
  echo "✓ Upgraded from v$current to v$latest."
  echo "  $copied file(s) copied, $merged template(s) frontmatter-merged."
  echo "  Run 'codepress lint' to check the project against the new lifecycle."
  if grep -lq '^[[:space:]]*status: *\(shaping\|approved\|delivering\|review\)' .codepress/product/galleys/*/galley.md 2>/dev/null; then
    echo "  Some galleys still use retired statuses — 'codepress migrate-status' plans the move."
  fi
}

# ─── Migrate ──────────────────────────────────────────────────────────────────

cmd_migrate() {
  echo "CodePress migrate — reshaping to 3-pillar model"
  echo ""

  if [[ -d ".codepress/system" ]]; then
    echo "  .codepress/system/ already exists — looks already migrated."
    echo "  Run 'codepress upgrade' to refresh system files instead."
    exit 0
  fi

  local has_old=false
  for d in 01-initiatives 02-product 03-delivery 04-patterns 05-domain; do
    [[ -d "$d" ]] && echo "  Found: $d/" && has_old=true
  done
  for f in codepress.md AGENTS.md; do
    [[ -f "$f" ]] && echo "  Found: $f" && has_old=true
  done
  for d in playbooks skills hooks; do
    [[ -d "$d" ]] && echo "  Found: $d/" && has_old=true
  done

  if [[ "$has_old" == false ]]; then
    echo "  No old structure detected. Nothing to migrate."
    exit 0
  fi

  echo ""
  echo "  This moves your PROJECT CONTENT into the 3-pillar model:"
  echo "    01-initiatives/   → .codepress/product/initiatives/"
  echo "    02-product/       → .codepress/product/galleys/"
  echo "    03-delivery/board → .codepress/views/galley-board.md"
  echo "    04-patterns/      → .codepress/knowledge/{signals,patterns}/"
  echo "    05-domain/        → .codepress/knowledge/"
  echo "    codepress.md      → .codepress/system/codepress.md (config preserved)"
  echo ""
  echo "  System files (playbooks, skills, templates, hooks, AGENTS.md) are"
  echo "  REPLACED with canonical v$VERSION files. Stale local copies that"
  echo "  reference the old numbered paths are removed (backed up first)."
  echo ""
  read -p "  Continue? [y/N] " confirm
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && echo "  Aborted." && exit 0

  mkdir -p .codepress/system .codepress/product/{initiatives,galleys,releases} .codepress/knowledge/{decisions,signals,patterns} .codepress/views docs

  # ── 1. Canonical system files (fixes the old empty-dir bug) ──
  populate_system_files || { echo "✗ Could not populate system files — aborting."; exit 1; }

  # ── 2. Move project content ──
  if [[ -d "01-initiatives" ]]; then
    mv 01-initiatives/* .codepress/product/initiatives/ 2>/dev/null || true
    rm -rf 01-initiatives && echo "  ✓ initiatives"
  fi
  if [[ -d "02-product" ]]; then
    # only galley content, skip old _templates (canonical templates live in system/)
    for item in 02-product/*; do
      [[ -e "$item" ]] || continue
      local base; base=$(basename "$item")
      [[ "$base" == "_templates" ]] && continue
      mv "$item" .codepress/product/galleys/ 2>/dev/null || true
    done
    rm -rf 02-product && echo "  ✓ galleys"
  fi
  if [[ -f "03-delivery/board.md" ]]; then
    mv 03-delivery/board.md .codepress/views/galley-board.md 2>/dev/null || true
  fi
  rm -rf 03-delivery 2>/dev/null && echo "  ✓ delivery board → views"
  if [[ -d "04-patterns" ]]; then
    [[ -d "04-patterns/signals" ]] && mv 04-patterns/signals/* .codepress/knowledge/signals/ 2>/dev/null || true
    [[ -d "04-patterns/patterns" ]] && mv 04-patterns/patterns/* .codepress/knowledge/patterns/ 2>/dev/null || true
    rm -rf 04-patterns && echo "  ✓ patterns + signals → knowledge"
  fi
  if [[ -d "05-domain" ]]; then
    [[ -d "05-domain/decisions" ]] && mv 05-domain/decisions/* .codepress/knowledge/decisions/ 2>/dev/null || true
    rm -rf 05-domain/decisions 2>/dev/null || true
    mv 05-domain/* .codepress/knowledge/ 2>/dev/null || true
    rm -rf 05-domain && echo "  ✓ domain → knowledge"
  fi

  # ── 3. Preserve project config (overwrites canonical placeholder) ──
  if [[ -f "codepress.md" ]]; then
    mv codepress.md .codepress/system/codepress.md 2>/dev/null || true
    # ensure version/source frontmatter from canonical is present
    [[ -d "$SCRIPT_DIR/.codepress/system" ]] && merge_frontmatter .codepress/system/codepress.md "$SCRIPT_DIR/.codepress/system/codepress.md"
    echo "  ✓ project config preserved → system/codepress.md"
  fi

  # ── 4. Back up + remove stale local system docs ──
  local backup=".codepress/system/_migrated-backup"
  for d in playbooks skills hooks; do
    if [[ -d "$d" ]]; then
      mkdir -p "$backup"
      mv "$d" "$backup/$d" 2>/dev/null || true
    fi
  done
  if [[ -f "AGENTS.md" ]] && ! grep -q "See .codepress/system/AGENTS.md" AGENTS.md 2>/dev/null; then
    mkdir -p "$backup"
    cp AGENTS.md "$backup/AGENTS.md" 2>/dev/null || true
  fi
  [[ -d "$backup" ]] && echo "  ✓ stale local system docs backed up → $backup/"

  # ── 5. Root pointer ──
  cat > AGENTS.md << 'EOF'
# CodePress

This project uses CodePress — a compound product development operating system.

See `.codepress/system/AGENTS.md` for the full operating manual.
See `.codepress/system/codepress.md` for project configuration.
EOF

  echo ""
  echo "✓ Migration complete. Review .codepress/system/_migrated-backup/ then delete it."
  echo "  Run 'codepress status' to verify."
}

# ─── Status detector ──────────────────────────────────────────────────────────

detect_pending_actions() {
  local format="${1:-text}"
  local action_count=0
  local out

  # 1. Initiatives ready for shaping (approved or shaping) with no matching Galley
  if [[ -d ".codepress/product/initiatives" ]]; then
    for f in .codepress/product/initiatives/*.md; do
      [[ ! -f "$f" ]] && continue
      local id init_status
      id=$(grep -m1 "^id:" "$f" 2>/dev/null | sed 's/id: *//')
      init_status=$(grep -m1 "^status:" "$f" 2>/dev/null | sed 's/status: *//' || echo "inbox")
      [[ -z "$id" ]] && id=$(basename "$f" .md)

      if [[ "$init_status" == "approved" || "$init_status" == "shaping" ]]; then
        local found=false
        if [[ -d ".codepress/product/galleys" ]]; then
          for g in .codepress/product/galleys/*/galley.md; do
            [[ -f "$g" ]] || continue
            local ref
            ref=$(grep -m1 "^initiative:" "$g" 2>/dev/null | sed 's/initiative: *//' || echo "")
            [[ "$ref" == "$id" ]] && found=true && break
          done
        fi
        if [[ "$found" == false ]]; then
          if [[ "$format" == "json" ]]; then
            out="create-galley|$id|Initiative '$id' is $init_status but no Galley exists"
          else
            echo "  create-galley  $id    Initiative '$id' is $init_status — no Galley yet"
          fi
          action_count=$((action_count + 1))
        fi
      fi
    done
  fi

  # 2. Galleys needing the next workflow step (canonical lifecycle statuses;
  #    retired values such as approved/delivering/review resolve through
  #    lifecycle.yaml, so un-migrated projects keep working)
  if [[ -d ".codepress/product/galleys" ]]; then
    for g in .codepress/product/galleys/*/galley.md; do
      [[ -f "$g" ]] || continue
      local gdir gname gstatus gcanon gflags
      gdir=$(dirname "$g")
      gname=$(basename "$gdir")
      [[ "$gname" == _* ]] && continue
      gstatus=$(grep -m1 "^status:" "$g" 2>/dev/null | sed 's/status: *//' || echo "")
      canon_status galley "$gstatus"
      gcanon="$CANON_STATUS"
      gflags="$CANON_FLAGS"

      local slug_count=0
      for s in "$gdir"/slugs/*.md; do
        [[ -f "$s" ]] && slug_count=$((slug_count + 1))
      done

      # shaped + approved but no slugs → needs split
      # (retired 'approved'/'ready' imply approval; canonical shaped needs approved_by)
      if [[ "$gcanon" == "shaped" ]]; then
        local approved=false
        [[ "$gflags" == *approved* ]] && approved=true
        [[ -n "$(get_fm_field "$g" approved_by)" ]] && approved=true
        if [[ "$approved" == true && "$slug_count" -eq 0 ]]; then
          if [[ "$format" == "json" ]]; then
            out="split-galley|$gname|Galley '$gname' is approved but has no slugs"
          else
            echo "  split-galley  $gname  Galley '$gname' is approved — no slugs yet"
          fi
          action_count=$((action_count + 1))
        fi
      fi

      # building with all slugs settled → needs review
      if [[ "$gcanon" == "building" ]]; then
        local total=0 complete=0
        for s in "$gdir"/slugs/*.md; do
          [[ ! -f "$s" ]] && continue
          total=$((total + 1))
          local sstatus
          sstatus=$(grep -m1 "^status:" "$s" 2>/dev/null | sed 's/status: *//' || echo "open")
          canon_status slug "$sstatus"
          [[ "$CANON_FLAGS" == *settled* ]] && complete=$((complete + 1))
        done
        if [[ "$total" -gt 0 && "$complete" -eq "$total" ]]; then
          if [[ "$format" == "json" ]]; then
            out="review|$gname|All slugs complete for '$gname', ready for review"
          else
            echo "  review          $gname  Galley '$gname' — all slugs complete, ready for review"
          fi
          action_count=$((action_count + 1))
        fi
      fi

      # verifying (review) → release + learn, then mark done
      if [[ "$gcanon" == "verifying" ]]; then
        if [[ "$format" == "json" ]]; then
          out="release+learn|$gname|Galley '$gname' review done, ready to release, capture knowledge, and mark done"
        else
          echo "  release+learn   $gname  Galley '$gname' — review done, ready to release + learn + mark done"
        fi
        action_count=$((action_count + 1))
      fi
    done
  fi

  # 3. Output machine-readable format if requested
  if [[ "$format" == "json" && -n "$out" ]]; then
    echo "$out"
  fi

  if [[ "$action_count" -eq 0 && "$format" != "json" ]]; then
    echo "  (no pending actions — all artefacts are in a consistent state)"
  fi

  return "$action_count"
}

# ─── Status ───────────────────────────────────────────────────────────────────

cmd_status() {
  local json_flag=false galleys_flag=false stalled_after=14
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_flag=true; shift ;;
      --galleys) galleys_flag=true; shift ;;
      --stalled-after) [[ $# -ge 2 ]] && { stalled_after="$2"; shift 2; } || shift ;;
      *) shift ;;
    esac
  done

  # Per-galley state for views and other tools: slug progress, last activity
  # (commits that NAME the galley count, not only commits touching its folder),
  # stalled flag, next action and who it needs (human | agent | verifier).
  if [[ "$json_flag" == true && "$galleys_flag" == true ]]; then
    run_lint_py status-json --root . --stalled-after "$stalled_after"
    return
  fi

  if [[ "$json_flag" == true ]]; then
    detect_pending_actions json || true
    return
  fi

  echo "CodePress status"
  echo ""

  local v
  v=$(get_codepress_version)
  echo "  Version:  v$v"
  echo ""

  # Initiatives
  local initiatives=0
  if [[ -d ".codepress/product/initiatives" ]]; then local _i; _i=(.codepress/product/initiatives/*.md); initiatives=${#_i[@]}; fi
  echo "  Initiatives:  $initiatives"

  # Galleys
  if [[ -d ".codepress/product/galleys" ]]; then
    local galley_count=0
    echo "  Galleys:"
    for galley in .codepress/product/galleys/*/; do
      name=$(basename "$galley")
      [[ "$name" == _* ]] && continue
      galley_count=$((galley_count + 1))
      gstatus="─"
      if [[ -f "$galley/galley.md" ]]; then
        gstatus=$(grep -m1 "^status:" "$galley/galley.md" 2>/dev/null | sed 's/status: *//' || echo "─")
      fi
      echo "    $name  [$gstatus]"
    done
    [[ "$galley_count" -eq 0 ]] && echo "    (none)"
  fi

  # Releases
  local releases=0
  if [[ -d ".codepress/product/releases" ]]; then local _r; _r=(.codepress/product/releases/*.md); releases=${#_r[@]}; fi
  echo "  Releases:  $releases"

  echo ""

  # Knowledge
  local patterns=0 signals=0 decisions=0
  if [[ -d ".codepress/knowledge/patterns" ]]; then local _p; _p=(.codepress/knowledge/patterns/*.md); patterns=${#_p[@]}; fi
  if [[ -d ".codepress/knowledge/signals" ]]; then local _s; _s=(.codepress/knowledge/signals/*.md); signals=${#_s[@]}; fi
  if [[ -d ".codepress/knowledge/decisions" ]]; then local _d; _d=(.codepress/knowledge/decisions/*.md); decisions=${#_d[@]}; fi
  echo "  Knowledge:  $patterns patterns  |  $signals signals  |  $decisions decisions"

  echo ""

  # Pending actions
  echo "  Pending actions:"
  detect_pending_actions text || true
  echo ""
  echo "  → Run 'codepress run' to execute the next pending action"
  echo ""
  regenerate_boards
}

# ─── Engine dispatch ──────────────────────────────────────────────────────────

resolve_engine() {
  local action="$1"
  local stage=""

  case "$action" in
    create-galley)  stage="shaping" ;;
    split-galley)   stage="split" ;;
    build)          stage="build" ;;
    review)         stage="review" ;;
    release+learn)  stage="release" ;; # primary stage for dispatch
    capture)        stage="capture" ;;
    compound)       stage="compound" ;;
  esac

  if [[ -z "$stage" ]]; then
    echo "claude"
    return
  fi

  if [[ -f ".codepress/system/codepress.md" ]]; then
    local engine
    engine=$(grep -A1 "^  $stage:" ".codepress/system/codepress.md" 2>/dev/null | grep -v "^--$" | tail -1 | sed 's/.*: *//')
    if [[ -n "$engine" ]]; then
      echo "$engine"
      return
    fi
  fi

  echo "claude"
}

dispatch_skill_for() {
  local action="$1"
  local target="$2"
  local engine
  engine=$(resolve_engine "$action")

  case "$action" in
    create-galley)
      echo "  Engine: $engine  →  skills/shape.md  (initiative: $target)"
      ;;
    split-galley)
      echo "  Engine: $engine  →  skills/split.md  (galley: $target)"
      ;;
    review)
      echo "  Engine: $engine  →  skills/review.md  (galley: $target)"
      ;;
    release+learn)
      local release_engine capture_engine
      release_engine=$(resolve_engine "release")
      capture_engine=$(resolve_engine "capture")
      echo "  Engine: $release_engine  →  skills/release.md  (galley: $target)"
      echo "  Engine: $capture_engine  →  skills/review.md  (galley: $target)"
      ;;
  esac
}

# ─── Board regeneration ──────────────────────────────────────────────────────

regenerate_boards() {
  local views=".codepress/views"
  local updated=false

  # Galley board
  if [[ -d ".codepress/product/galleys" && -d "$views" ]]; then
    {
      echo "---"
      echo "kanban-plugin: board"
      echo "---"
      echo ""
      # Column headings keep their familiar names; each holds the canonical
      # lifecycle status it corresponds to (retired values resolve to them).
      for pair in "Shaping:proposed" "Approved:shaped" "Delivering:building" "Review:verifying" "Done:done"; do
        local heading="${pair%%:*}"
        local slug="${pair##*:}"
        echo "## $heading"
        echo ""
        for g in .codepress/product/galleys/*/galley.md; do
          [[ -f "$g" ]] || continue
          local gdir gname gstatus gtitle
          gdir=$(dirname "$g")
          gname=$(basename "$gdir")
          [[ "$gname" == _* ]] && continue
          gstatus=$(grep -m1 "^status:" "$g" 2>/dev/null | sed 's/status: *//' || echo "")
          canon_status galley "$gstatus"
          [[ "$CANON_STATUS" != "$slug" ]] && continue
          gtitle=$(grep -m1 "^# Galley:" "$g" 2>/dev/null | sed 's/# Galley: *//' || echo "$gname")
          local checkbox=" "
          [[ "$heading" == "Done" ]] && checkbox="x"
          rel=".codepress/product/galleys/$gname/galley"
          echo "- [$checkbox] [[$rel|$gtitle]]"
        done
        echo ""
      done
      echo "%% kanban:settings"
      echo '```'
      echo '{"kanban-plugin":"board","list-collapse":[false,false,false,false,false]}'
      echo '```'
      echo "%%"
    } > "$views/galley-board.md"
    updated=true
  fi

  # Initiative board
  if [[ -d ".codepress/product/initiatives" && -d "$views" ]]; then
    {
      echo "# Initiative Board"
      echo ""
      echo "Overview of all initiatives — ideas and problems worth solving."
      echo ""
      echo "---"
      echo ""
      echo "## Active"
      echo "| Initiative | Status | Priority |"
      echo "|---|---|---|"
      for f in .codepress/product/initiatives/*.md; do
        [[ -f "$f" ]] || continue
        local iid istatus
        iid=$(grep -m1 "^# Initiative:" "$f" 2>/dev/null | sed 's/# Initiative: *//' || basename "$f" .md)
        istatus=$(grep -m1 "^status:" "$f" 2>/dev/null | sed 's/status: *//' || echo "draft")
        [[ "$istatus" != "draft" && "$istatus" != "completed" ]] && echo "| $iid | $istatus | — |"
      done
      echo ""
      echo "## Backlog"
      echo "| Initiative | Status | Priority |"
      echo "|---|---|---|"
      for f in .codepress/product/initiatives/*.md; do
        [[ -f "$f" ]] || continue
        iid=$(grep -m1 "^# Initiative:" "$f" 2>/dev/null | sed 's/# Initiative: *//' || basename "$f" .md)
        istatus=$(grep -m1 "^status:" "$f" 2>/dev/null | sed 's/status: *//' || echo "draft")
        [[ "$istatus" == "draft" ]] && echo "| $iid | $istatus | — |"
      done
      echo ""
      echo "## Completed"
      echo "| Initiative | Galley | Status |"
      echo "|---|---|---|"
      for f in .codepress/product/initiatives/*.md; do
        [[ -f "$f" ]] || continue
        iid=$(grep -m1 "^# Initiative:" "$f" 2>/dev/null | sed 's/# Initiative: *//' || basename "$f" .md)
        istatus=$(grep -m1 "^status:" "$f" 2>/dev/null | sed 's/status: *//' || echo "draft")
        [[ "$istatus" == "completed" ]] && echo "| $iid | — | $istatus |"
      done
    } > "$views/initiative-board.md"
    updated=true
  fi

  # Release board
  if [[ -d ".codepress/product/releases" && -d "$views" ]]; then
    {
      echo "# Release Board"
      echo ""
      echo "---"
      echo ""
      echo "## Upcoming"
      echo "| Release | Galleys | Target |"
      echo "|---|---|---|"
      echo ""
      echo "## Current"
      echo "| Release | Galleys | Status |"
      echo "|---|---|---|"
      echo ""
      echo "## Shipped"
      echo "| Release | Date | Galleys |"
      echo "|---|---|---|"
    } > "$views/release-board.md"
    updated=true
  fi

  if [[ "$updated" == true ]]; then
    echo "  ✓ Boards regenerated"
  fi
}

execute_action() {
  local action="$1"
  local target="$2"
  local script_dir=".codepress/system"
  local skill_file=""

  case "$action" in
    create-galley)
      skill_file="$script_dir/skills/shape.md"
      echo "  Skill: $skill_file"
      if [[ -f "$skill_file" ]]; then
        cat "$skill_file"
      else
        echo "  ⚠ Skill file not found: $skill_file"
        return 2
      fi
      echo "  → Hand off to $(resolve_engine "$action") with initiative '$target'"
      ;;

    split-galley)
      skill_file="$script_dir/skills/split.md"
      echo "  Skill: $skill_file"
      if [[ -f "$skill_file" ]]; then
        cat "$skill_file"
      else
        echo "  ⚠ Skill file not found: $skill_file"
        return 2
      fi
      echo "  → Hand off to $(resolve_engine "$action") with galley '$target'"
      ;;

    review)
      skill_file="$script_dir/skills/review.md"
      echo "  Skill: $skill_file"
      if [[ -f "$skill_file" ]]; then
        cat "$skill_file"
      else
        echo "  ⚠ Skill file not found: $skill_file"
        return 2
      fi
      echo "  → Hand off to $(resolve_engine "$action") for galley '$target'"
      ;;

    release+learn)
      local release_file="$script_dir/skills/release.md"
      local review_file="$script_dir/skills/review.md"
      echo "  Skill: $release_file"
      [[ -f "$release_file" ]] && cat "$release_file" || echo "  ⚠ File not found: $release_file"
      echo ""
      echo "  Skill: $review_file"
      [[ -f "$review_file" ]] && cat "$review_file" || echo "  ⚠ File not found: $review_file"
      echo "  → Hand off to $(resolve_engine "release") and $(resolve_engine "capture") for galley '$target'"
      ;;
  esac
}

# ─── Run ──────────────────────────────────────────────────────────────────────

cmd_run() {
  local all_flag=false
  [[ "${1:-}" == "--all" ]] && all_flag=true

  local tmpfile
  tmpfile=$(mktemp)
  detect_pending_actions json > "$tmpfile" 2>/dev/null || true
  local pending=()
  while IFS='|' read -r action target desc; do
    [[ -z "$action" ]] && continue
    pending+=("$action|$target|$desc")
  done < "$tmpfile"

  if [[ ${#pending[@]} -eq 0 ]]; then
    echo "No pending actions — all artefacts are in a consistent state."
    rm -f "$tmpfile"
    return
  fi

  if [[ "$all_flag" == false ]]; then
    IFS='|' read -r action target desc <<< "${pending[0]}"
    echo "Next pending action:"
    echo "  $action  $target"
    echo "  $desc"
    echo ""
    echo "Engine dispatch:"
    dispatch_skill_for "$action" "$target"
    echo ""
    read -p "Execute this action? [y/N] " confirm
    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
      echo ""
      execute_action "$action" "$target"
      echo ""
      regenerate_boards
      echo ""
      echo "✓ Action dispatched. Run 'codepress status' to see updated state."
    else
      echo "  Skipped."
    fi
  else
    echo "Executing ${#pending[@]} pending action(s)..."
    echo ""
    for entry in "${pending[@]}"; do
      IFS='|' read -r action target desc <<< "$entry"
      echo "─── $action  $target ───"
      echo "  $desc"
      echo ""
      dispatch_skill_for "$action" "$target"
      echo ""
      read -p "Execute? [y/N] " confirm
      if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        execute_action "$action" "$target"
        regenerate_boards
        echo ""
        echo "✓ Done."
      else
        echo "  Skipped."
      fi
      echo ""
    done
    echo "All actions processed."
  fi

  rm -f "$tmpfile"
}

# ─── Watch ─────────────────────────────────────────────────────────────────────

cmd_watch() {
  local watched=".codepress/product"
  local interval="${1:-2}"

  if ! command -v fswatch &>/dev/null; then
    echo "codepress watch requires fswatch."
    echo "  Install: brew install fswatch"
    exit 1
  fi

  echo "CodePress watch — monitoring $watched/ (every ${interval}s)"
  echo "  Press Ctrl+C to stop."
  echo ""

  # Initial scan
  detect_pending_actions text

  fswatch -0 -l "$interval" "$watched" 2>/dev/null | while read -d "" event; do
    echo ""
    echo "─── change detected: $(basename "$(dirname "$event")") ───"
    local count=0
    detect_pending_actions json > /tmp/codepress-pending 2>/dev/null || true
    count=$(grep -c "" /tmp/codepress-pending 2>/dev/null || echo "0")
    if [[ "$count" -gt 0 ]]; then
      echo "  ${count} pending action(s) — running..."
      cmd_run --all < /dev/null
      regenerate_boards
    else
      echo "  No pending actions."
    fi
    echo "  Watching..."
  done
}

# ─── Galley commands ──────────────────────────────────────────────────────────

cmd_galley_new() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "✗ Usage: codepress galley new <name>"
    exit 1
  fi

  local dir=".codepress/product/galleys/$name"
  if [[ -d "$dir" ]]; then
    echo "✗ Galley '$name' already exists at $dir/"
    exit 1
  fi

  mkdir -p "$dir/slugs"

  if [[ -f ".codepress/system/templates/galley.md" ]]; then
    cp ".codepress/system/templates/galley.md" "$dir/galley.md"
    set_fm_field "$dir/galley.md" id "$name"
    set_fm_field "$dir/galley.md" created "$(date +%Y-%m-%d)"
  else
    cat > "$dir/galley.md" << EOF
---
id: $name
status: proposed
created: $(date +%Y-%m-%d)
---

# Galley: $name

## Problem

## Success

## Approach

## Acceptance Criteria
EOF
  fi

  # Create review.md from the template (so Signals / Evidence / Verdict exist)
  if [[ -f ".codepress/system/templates/review.md" ]]; then
    sed "s/{galley-name}/$name/" ".codepress/system/templates/review.md" > "$dir/review.md"
  else
    cat > "$dir/review.md" << EOF
# Review: $name

## Signals

## Evidence

## Verdict
EOF
  fi

  echo "✓ Galley '$name' created at $dir/"
  echo "  Next: shape galley.md, then 'codepress galley move $name shaped'"
}

cmd_galley_list() {
  if [[ ! -d ".codepress/product/galleys" ]]; then
    echo "  No galleys found (.codepress/product/galleys/ does not exist)."
    return
  fi

  local found=false
  for galley in .codepress/product/galleys/*/; do
    name=$(basename "$galley")
    [[ "$name" == _* ]] && continue
    found=true
    status="─"
    if [[ -f "$galley/galley.md" ]]; then
      status=$(grep -m1 "^status:" "$galley/galley.md" 2>/dev/null | sed 's/status: *//' || echo "─")
    fi
    printf "  %-30s [%s]\n" "$name" "$status"
  done

  [[ "$found" == false ]] && echo "  (no galleys yet — use 'codepress galley new <name>')"
}

# ─── Acceptance-criteria binding (galley: enforced-acceptance) ────────────────

# extract_acs <file> — parse the first "## Acceptance ..." section (galley
# "Acceptance Criteria" or slug "Acceptance checklist") and emit one line per
# checkbox criterion:   id|kind|payload|ticked
#
# Grammar (one line each, fields separated by " · " space-middot-space):
#   - [ ] <id> · Given … · When … · Then … · test: <path::name>   kind=test, payload=<ref>
#   - [ ] <id> · check: <shell command>                            kind=check, payload=<command>
#   - [ ] <id> · manual: <human-only step>                         kind=manual, payload=<step>
#   - [ ] any unbound prose                                        kind=legacy, payload=<text>, id empty
# ticked is 1 for "- [x]", else 0. Payloads must not contain "|".
extract_acs() {
  local file="${1:-}"
  if [[ -z "$file" || ! -f "$file" ]]; then
    echo "✗ extract_acs: file not found: ${file:-<none>}" >&2
    return 1
  fi
  awk '
    # Lines inside an HTML comment block are not criteria (mirrors lint.py).
    incomment { if (index($0, "-->") > 0) incomment = 0; next }
    index($0, "<!--") > 0 {
      rest = substr($0, index($0, "<!--") + 4)
      if (index(rest, "-->") == 0) { incomment = 1; next }
    }
    /^## Acceptance/ { insec = 1; next }
    insec && /^## /  { insec = 0 }
    insec && /^- \[[ xX]\] / {
      line = $0
      ticked = (line ~ /^- \[[xX]\]/) ? 1 : 0
      sub(/^- \[[ xX]\][ \t]*/, "", line)
      sub(/[ \t]+$/, "", line)
      id = ""; kind = "legacy"; payload = line
      if (index(line, " · ") > 0) id = substr(line, 1, index(line, " · ") - 1)
      if (match(line, / · check: /)) {
        kind = "check"; payload = substr(line, RSTART + RLENGTH)
      } else if (match(line, / · manual: /)) {
        kind = "manual"; payload = substr(line, RSTART + RLENGTH)
      } else if (match(line, / · test: /)) {
        kind = "test"; payload = substr(line, RSTART + RLENGTH)
      } else {
        id = ""
      }
      print id "|" kind "|" payload "|" ticked
    }
  ' "$file"
}

# Gate command for <gate> from the "verify:" block in codepress.md.
# Handles single-line values and folded (>) multi-line values.
get_gate_command() {
  local gate="$1" cfg
  cfg=$(resolve_config)
  [[ -f "$cfg" ]] || return 0
  awk -v g="$gate" '
    /^verify:[ \t]*$/ { inv = 1; next }
    inv && /^[^ \t]/  { inv = 0; if (fold) exit }
    inv {
      if (!fold && $0 ~ ("^  " g ":")) {
        val = $0
        sub("^  " g ":[ \t]*", "", val)
        if (val == ">") { fold = 1; next }
        print val; exit
      } else if (fold) {
        if ($0 ~ /^    /) { l = $0; sub(/^[ \t]+/, "", l); buf = buf l " " }
        else { sub(/[ \t]+$/, "", buf); print buf; exit }
      }
    }
    END { if (fold && buf != "") { sub(/[ \t]+$/, "", buf); print buf } }
  ' "$cfg"
}

# Engine assigned to <stage> in the "engines:" block of codepress.md.
# Defaults to DEFAULT_ENGINE (documented default when the block is missing);
# lint.py receives the same default through the environment.
DEFAULT_ENGINE="claude"
export CODEPRESS_DEFAULT_ENGINE="$DEFAULT_ENGINE"
get_engine() {
  local stage="$1" cfg engine=""
  cfg=$(resolve_config)
  if [[ -f "$cfg" ]]; then
    engine=$(awk -v s="$stage" '
      /^engines:[ \t]*$/ { ine = 1; next }
      ine && /^[^ \t]/   { ine = 0 }
      ine && $0 ~ ("^  " s ":") {
        val = $0
        sub("^  " s ":[ \t]*", "", val)
        sub(/[ \t]*#.*$/, "", val)
        sub(/[ \t]+$/, "", val)
        print val; exit
      }
    ' "$cfg")
  fi
  echo "${engine:-$DEFAULT_ENGINE}"
}

# Optional "test-runner:" template from codepress.md — how `codepress check`
# runs a per-AC test: ref. Placeholders: {ref} {file} {name}.
get_test_runner() {
  local cfg
  cfg=$(resolve_config)
  [[ -f "$cfg" ]] || return 0
  grep -m1 '^test-runner:' "$cfg" 2>/dev/null | sed 's/^test-runner:[ ]*//' || true
}

# True when review.md's "## Signals" section has real content
# (blank lines and HTML comments do not count).
has_signals() {
  local rfile="$1"
  [[ -f "$rfile" ]] || return 1
  awk '/^## Signals/ { f = 1; next } /^## / { f = 0 } f' "$rfile" \
    | awk '/<!--/ { c = 1 } !c { print } /-->/ { c = 0 }' \
    | grep -q '[^[:space:]]'
}

# Verdict gate for → done. The "## Verdict" block in review.md must contain
# one "ACn: pass — evidence" line per bound AC, zero fails, and be attributed
# to an engine other than engines.build (self-certification is refused).
# Prints per-problem lines; returns non-zero on refusal.
check_verdict() {
  local name="$1"
  local gfile=".codepress/product/galleys/$name/galley.md"
  local rfile=".codepress/product/galleys/$name/review.md"
  local fails=0 vsec verified_by verified_on build_engine

  if [[ ! -f "$rfile" ]]; then
    echo "  ❌ verdict: no review.md at $rfile"
    return 1
  fi

  vsec=$(awk '/^## Verdict/ { f = 1; next } /^## / { f = 0 } f' "$rfile" \
    | awk '/<!--/ { c = 1 } !c { print } /-->/ { c = 0 }')

  if ! echo "$vsec" | grep -q '[^[:space:]]'; then
    echo "  ❌ verdict: no completed ## Verdict block in $rfile"
    echo "     (the verifier engine writes it — see skills/verify.md; the builder never does)"
    return 1
  fi

  verified_by=$(echo "$vsec" | grep -m1 '^verified-by:' | sed 's/^verified-by:[ ]*//; s/[ \t]*$//' || true)
  verified_on=$(echo "$vsec" | grep -m1 '^verified-on:' | sed 's/^verified-on:[ ]*//; s/[ \t]*$//' || true)
  build_engine=$(get_engine build)

  if [[ -z "$verified_by" ]]; then
    echo "  ❌ verdict: missing verified-by: line"
    fails=$((fails + 1))
  elif [[ "$verified_by" == "$build_engine" ]]; then
    echo "  ❌ verdict: verified-by '$verified_by' equals engines.build — the builder cannot verdict its own work"
    fails=$((fails + 1))
  fi
  if [[ -z "$verified_on" ]]; then
    echo "  ❌ verdict: missing verified-on: line"
    fails=$((fails + 1))
  fi

  local id kind payload ticked vline
  while IFS='|' read -r id kind payload ticked; do
    [[ "$kind" == "legacy" || -z "$id" ]] && continue
    vline=$(echo "$vsec" | grep -m1 "^$id:" || true)
    if [[ -z "$vline" ]]; then
      echo "  ❌ verdict: $id has no verdict line"
      fails=$((fails + 1))
    elif ! echo "$vline" | grep -qE "^$id:[ ]*pass"; then
      echo "  ❌ verdict: $vline"
      fails=$((fails + 1))
    fi
  done < <(extract_acs "$gfile")

  [[ "$fails" -gt 0 ]] && return 1
  echo "  ✅ verdict: all ACs pass — verified-by: $verified_by ($verified_on)"
  return 0
}

# ─── codepress check ──────────────────────────────────────────────────────────

# codepress check <galley> — run the galley's verify: gates fresh, then
# evaluate every bound AC: test: refs via the test-runner: template (or the
# full test gate, with a warning), check: commands (exit 0 = pass), manual:
# lines must not be ticked. Legacy unbound lines warn only.
# Exit non-zero iff a gate or a bound AC fails.
cmd_check() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "✗ Usage: codepress check <galley>"
    exit 1
  fi
  local gfile=".codepress/product/galleys/$name/galley.md"
  if [[ ! -f "$gfile" ]]; then
    echo "✗ Galley '$name' not found at $gfile"
    exit 1
  fi

  local fails=0 warns=0
  echo "codepress check — $name"

  # ── 1. verify: gates, run fresh from codepress.md ──
  local gate_list gate gate_cmd gate_out gate_rc
  gate_list=$(awk 'NR == 1 && /^---/ { fm = 1; next } fm && /^---/ { exit } fm' "$gfile" \
    | grep -m1 '^verify:' | sed 's/^verify:[ ]*//' | tr -d '[]' | tr ',' ' ' || true)
  gate_list=$(echo "$gate_list" | xargs 2>/dev/null || true)
  echo ""
  if [[ -n "$gate_list" ]]; then
    echo "Gates (verify: [$gate_list]):"
    for gate in $gate_list; do
      gate_cmd=$(get_gate_command "$gate")
      if [[ -z "$gate_cmd" ]]; then
        echo "  ⚠️  $gate — no command defined in $(resolve_config)"
        warns=$((warns + 1))
        continue
      fi
      set +e
      gate_out=$(bash -c "$gate_cmd" 2>&1)
      gate_rc=$?
      set -e
      if [[ "$gate_rc" -eq 0 ]]; then
        echo "  ✅ $gate — $gate_cmd"
      else
        echo "  ❌ $gate — $gate_cmd (exit $gate_rc)"
        echo "$gate_out" | tail -5 | sed 's/^/       /'
        fails=$((fails + 1))
      fi
    done
  else
    echo "Gates: (none declared in galley frontmatter)"
  fi

  # ── 2. acceptance criteria ──
  echo ""
  echo "Acceptance criteria:"
  local runner ac_total=0
  runner=$(get_test_runner)
  local fallback_rc="" fallback_warned=0
  # cache: identical runner commands execute once (bash 3.2 — parallel arrays)
  local _cc_cmds=() _cc_rcs=()

  local id kind payload ticked
  local tfile tname tcmd tout trc cout crc i cached_rc tgate
  while IFS='|' read -r id kind payload ticked; do
    ac_total=$((ac_total + 1))
    case "$kind" in
      test)
        tfile="${payload%%::*}"
        tname=""
        [[ "$payload" == *::* ]] && tname="${payload##*::}"
        if [[ ! -f "$tfile" ]]; then
          echo "  ❌ $id · test: $payload — file not found: $tfile"
          fails=$((fails + 1))
          continue
        fi
        if [[ -n "$tname" ]] && ! grep -q "$tname" "$tfile"; then
          echo "  ❌ $id · test: $payload — '$tname' not found in $tfile"
          fails=$((fails + 1))
          continue
        fi
        if [[ -n "$runner" ]]; then
          tcmd="$runner"
          tcmd="${tcmd//\{ref\}/$payload}"
          tcmd="${tcmd//\{file\}/$tfile}"
          tcmd="${tcmd//\{name\}/$tname}"
          cached_rc=""
          for ((i = 0; i < ${#_cc_cmds[@]}; i++)); do
            [[ "${_cc_cmds[$i]}" == "$tcmd" ]] && cached_rc="${_cc_rcs[$i]}" && break
          done
          if [[ -n "$cached_rc" ]]; then
            trc="$cached_rc"
            tout="(cached — '$tcmd' already ran)"
          else
            set +e
            tout=$(bash -c "$tcmd" 2>&1)
            trc=$?
            set -e
            _cc_cmds+=("$tcmd")
            _cc_rcs+=("$trc")
          fi
          if [[ "$trc" -eq 0 ]]; then
            echo "  ✅ $id · test: $payload"
          else
            echo "  ❌ $id · test: $payload — '$tcmd' exit $trc"
            echo "$tout" | tail -5 | sed 's/^/       /'
            fails=$((fails + 1))
          fi
        else
          if [[ "$fallback_warned" -eq 0 ]]; then
            echo "  ⚠️  no test-runner: template in $(resolve_config) — running the full 'test' gate once; per-AC attribution unavailable"
            warns=$((warns + 1))
            fallback_warned=1
          fi
          if [[ -z "$fallback_rc" ]]; then
            tgate=$(get_gate_command test)
            if [[ -z "$tgate" ]]; then
              fallback_rc=127
            else
              set +e
              bash -c "$tgate" > /dev/null 2>&1
              fallback_rc=$?
              set -e
            fi
          fi
          if [[ "$fallback_rc" -eq 127 ]]; then
            echo "  ❌ $id · test: $payload — no test-runner: and no 'test' gate defined; cannot evaluate"
            fails=$((fails + 1))
          elif [[ "$fallback_rc" -eq 0 ]]; then
            echo "  ✅ $id · test: $payload (via full test gate)"
          else
            echo "  ❌ $id · test: $payload — full test gate failed (exit $fallback_rc)"
            fails=$((fails + 1))
          fi
        fi
        ;;
      check)
        set +e
        cout=$(bash -c "$payload" 2>&1)
        crc=$?
        set -e
        if [[ "$crc" -eq 0 ]]; then
          echo "  ✅ $id · check: $payload"
        else
          echo "  ❌ $id · check: $payload (exit $crc)"
          echo "$cout" | tail -5 | sed 's/^/       /'
          fails=$((fails + 1))
        fi
        ;;
      manual)
        if [[ "$ticked" == "1" ]]; then
          echo "  ❌ $id · manual: $payload — ticked [x]: manual steps are never ticked by agents."
          echo "       Untick it; a human attests it in the Verdict, or moves with --force."
          fails=$((fails + 1))
        else
          echo "  ⚠️  $id · manual: $payload — requires human verification (not machine-evaluated)"
          warns=$((warns + 1))
        fi
        ;;
      *)
        echo "  ⚠️  (legacy) unbound AC — warns only, not machine-evaluated: $payload"
        warns=$((warns + 1))
        ;;
    esac
  done < <(extract_acs "$gfile")

  if [[ "$ac_total" -eq 0 ]]; then
    echo "  ⚠️  no acceptance criteria found in $gfile"
    warns=$((warns + 1))
  fi

  echo ""
  if [[ "$fails" -gt 0 ]]; then
    echo "Result: ❌ FAIL — $fails failing, $warns warning(s)"
    return 1
  fi
  echo "Result: ✅ PASS — $ac_total criteria evaluated, $warns warning(s)"
  return 0
}

galley_move_legacy() {
  local name="" target="" force=false reason=""
  local valid_statuses="shaping approved delivering review done"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      --reason)
        if [[ $# -ge 2 ]]; then reason="$2"; shift 2; else shift; fi
        ;;
      *)
        if [[ -z "$name" ]]; then name="$1"
        elif [[ -z "$target" ]]; then target="$1"
        else echo "✗ Unexpected argument: $1"; exit 1
        fi
        shift ;;
    esac
  done

  if [[ -z "$name" || -z "$target" ]]; then
    echo "✗ Usage: codepress galley move <name> <status> [--force] [--reason <text>]"
    echo "  Status: shaping | approved | delivering | review | done"
    exit 1
  fi

  if ! echo "$valid_statuses" | grep -wq "$target"; then
    echo "✗ Invalid status '$target'. Valid: shaping approved delivering review done"
    exit 1
  fi

  local file=".codepress/product/galleys/$name/galley.md"
  local rfile=".codepress/product/galleys/$name/review.md"
  if [[ ! -f "$file" ]]; then
    echo "✗ Galley '$name' not found at $file"
    exit 1
  fi

  local from
  from=$(grep -m1 "^status:" "$file" 2>/dev/null | sed 's/status: *//' || echo "?")

  # ── Gates: → review and → done are guarded; earlier statuses are not ──
  if [[ "$force" != true && ( "$target" == "review" || "$target" == "done" ) ]]; then
    local check_out check_rc
    set +e
    check_out=$(cmd_check "$name" 2>&1)
    check_rc=$?
    set -e
    if [[ "$check_rc" -ne 0 ]]; then
      echo "✗ Move to [$target] refused — 'codepress check $name' fails:"
      echo ""
      echo "$check_out" | sed 's/^/  /'
      echo ""
      echo "  Fix the failing criteria, or override with --force (records a waiver in review.md)."
      exit 1
    fi
    if [[ "$target" == "review" ]] && ! has_signals "$rfile"; then
      echo "✗ Move to [review] refused — ## Signals in $rfile is empty."
      echo "  A galley with zero signals learned nothing. Capture observations first, or --force."
      exit 1
    fi
    if [[ "$target" == "done" ]]; then
      local verdict_out verdict_rc
      set +e
      verdict_out=$(check_verdict "$name" 2>&1)
      verdict_rc=$?
      set -e
      if [[ "$verdict_rc" -ne 0 ]]; then
        echo "✗ Move to [done] refused — verdict gate fails:"
        echo "$verdict_out"
        echo "  An independent verifier (≠ engines.build) must complete ## Verdict in review.md"
        echo "  (see skills/verify.md), or override with --force (records a waiver)."
        exit 1
      fi
    fi
  fi

  # --force on a gated transition leaves a dated waiver trace in review.md
  if [[ "$force" == true && ( "$target" == "review" || "$target" == "done" ) ]]; then
    [[ -f "$rfile" ]] || echo "# Review: $name" > "$rfile"
    {
      echo ""
      echo "> waived: $(date +%Y-%m-%d) ${from}→${target} by human — ${reason:-unstated}"
    } >> "$rfile"
    echo "⚠ Gates bypassed with --force — waiver recorded in $rfile"
  fi

  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^status:.*/status: $target/" "$file"
  else
    sed -i "s/^status:.*/status: $target/" "$file"
  fi

  echo "✓ Galley '$name' moved to [$target]"
  regenerate_boards
}

# ─── Lifecycle moves ──────────────────────────────────────────────────────────

# Which vocabulary governs a move? The galley's current status decides.
#   canonical status (proposed/shaped/building/verifying/done/killed/superseded)
#       → the lifecycle in schema/lifecycle.yaml: allowed edges + gates as data.
#   retired or unknown status (shaping/approved/delivering/review, ...)
#       → the legacy gates (check + signals → review, verdict → done), so
#         un-migrated projects keep working until their statuses are migrated.
cmd_galley_move() {
  local a first=""
  local skip=false
  for a in "$@"; do
    if [[ "$skip" == true ]]; then skip=false; continue; fi
    case "$a" in
      --reason|--superseded-by) skip=true ;;
      --*) ;;
      *) first="$a"; break ;;
    esac
  done
  local file=".codepress/product/galleys/${first}/galley.md"
  if [[ -n "$first" && -f "$file" ]]; then
    local cur
    cur=$(get_fm_field "$file" status)
    canon_status galley "$cur"
    if [[ "$CANON_KNOWN" == true && "$CANON_FLAGS" != *retired* ]]; then
      galley_move_strict "$@"
      return
    fi
  fi
  galley_move_legacy "$@"
}

galley_move_strict() {
  local name="" target="" force=false reason="" superseded_by=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      --reason) [[ $# -ge 2 ]] && { reason="$2"; shift 2; } || shift ;;
      --superseded-by) [[ $# -ge 2 ]] && { superseded_by="$2"; shift 2; } || shift ;;
      *)
        if [[ -z "$name" ]]; then name="$1"
        elif [[ -z "$target" ]]; then target="$1"
        else echo "✗ Unexpected argument: $1"; exit 1
        fi
        shift ;;
    esac
  done
  if [[ -z "$name" || -z "$target" ]]; then
    echo "✗ Usage: codepress galley move <name> <status> [--force] [--reason <text>] [--superseded-by <galley>]"
    exit 1
  fi

  local file=".codepress/product/galleys/$name/galley.md"
  local rfile=".codepress/product/galleys/$name/review.md"
  local from
  from=$(get_fm_field "$file" status)

  # Target must be a canonical status.
  canon_status galley "$target"
  if [[ "$CANON_KNOWN" == true && "$CANON_FLAGS" == *retired* ]]; then
    echo "✗ '$target' is a retired status — use '$CANON_STATUS' (see schema/lifecycle.yaml)."
    exit 1
  fi
  if [[ "$CANON_KNOWN" != true ]]; then
    echo "✗ Invalid status '$target'. Valid: $(printf '%s\n' "$_STATUS_TABLE" | awk '$1 == "galley" && $4 !~ /retired/ { printf "%s ", $2 }')"
    exit 1
  fi

  if [[ "$from" == "$target" ]]; then
    echo "✓ Galley '$name' is already [$target]"
    return 0
  fi

  # killed / superseded take their reason from the flags.
  local edge_rc=0
  run_lint_py requires "$from" "$target" >/dev/null 2>&1 || edge_rc=$?
  if [[ "$edge_rc" -eq 0 ]]; then
    [[ "$target" == "killed" && -n "$reason" ]] && set_fm_field "$file" closed_reason "$(yaml_value "$reason")"
    [[ "$target" == "superseded" && -n "$superseded_by" ]] && set_fm_field "$file" superseded_by "$superseded_by"
  fi

  # Static gates (and the edge itself) are decided by lint.py.
  local gate_out gate_rc=0
  gate_out=$(run_lint_py gate "$name" "$from" "$target" 2>&1) || gate_rc=$?

  # Dynamic gates run here.
  local dyn_out="" dyn_rc=0 gate_id gate_kind
  if [[ "$edge_rc" -eq 0 ]]; then
    while read -r gate_id gate_kind; do
      [[ "$gate_kind" == "dynamic" ]] || continue
      case "$gate_id" in
        ac_check)
          local co crc=0
          co=$(cmd_check "$name" 2>&1) || crc=$?
          if [[ "$crc" -ne 0 ]]; then
            dyn_rc=1
            dyn_out+="$co"$'\n'
          fi
          ;;
      esac
    done < <(run_lint_py requires "$from" "$target" 2>/dev/null)
  fi

  local refused=false
  if [[ "$gate_rc" -ne 0 || "$dyn_rc" -ne 0 ]]; then refused=true; fi

  if [[ "$refused" == true && "$force" != true ]]; then
    echo "✗ Move [$from] → [$target] refused:"
    echo ""
    [[ -n "$gate_out" ]] && echo "$gate_out" | sed 's/^/  /'
    [[ -n "$dyn_out" ]] && echo "$dyn_out" | sed 's/^/  /'
    echo ""
    echo "  Satisfy the gates, or override with --force --reason \"...\" (records a waiver in review.md;"
    echo "  lint treats the waived gates as warnings — no --no-verify needed)."
    exit 1
  fi

  if [[ "$refused" == true && "$force" == true ]]; then
    [[ -f "$rfile" ]] || echo "# Review: $name" > "$rfile"
    {
      echo ""
      echo "> waived: $(date +%Y-%m-%d) ${from}→${target} by human — ${reason:-unstated}"
    } >> "$rfile"
    echo "⚠ Gates bypassed with --force — waiver recorded in $rfile"
  fi

  set_fm_field "$file" status "$target"
  echo "✓ Galley '$name' moved to [$target]"
  regenerate_boards
}

# codepress galley approve <name> [--by <who>] — record human approval of the
# shape. Approval is a gate on shaped → building, not a status of its own.
cmd_galley_approve() {
  local name="" by=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --by) [[ $# -ge 2 ]] && { by="$2"; shift 2; } || shift ;;
      *) if [[ -z "$name" ]]; then name="$1"; else echo "✗ Unexpected argument: $1"; exit 1; fi; shift ;;
    esac
  done
  if [[ -z "$name" ]]; then
    echo "✗ Usage: codepress galley approve <name> [--by <who>]"
    exit 1
  fi
  local file=".codepress/product/galleys/$name/galley.md"
  if [[ ! -f "$file" ]]; then
    echo "✗ Galley '$name' not found at $file"
    exit 1
  fi
  local cur
  cur=$(get_fm_field "$file" status)
  canon_status galley "$cur"
  if [[ "$CANON_STATUS" != "shaped" ]]; then
    echo "✗ Only a shaped galley can be approved ('$name' is [$cur])."
    [[ "$CANON_STATUS" == "proposed" ]] && echo "  Shape it first, then: codepress galley move $name shaped"
    exit 1
  fi
  local shape_out
  if ! shape_out=$(run_lint_py eval "$name" shape_complete 2>&1); then
    echo "✗ Cannot approve an incomplete shape:"
    echo "$shape_out" | sed 's/^/  /'
    exit 1
  fi
  if [[ -z "$by" ]]; then
    by=$(git config user.name 2>/dev/null || true)
    by="${by:-${USER:-unknown}}"
  fi
  set_fm_field "$file" approved_by "$(yaml_value "$by")"
  set_fm_field "$file" approved_on "$(date +%Y-%m-%d)"
  echo "✓ Galley '$name' approved by $by"
  echo "  Next: codepress galley move $name building"
}

# codepress migrate-status [--apply] — move a project's galley and slug statuses
# onto the lifecycle vocabulary using the mapping in schema/lifecycle.yaml.
# Dry run by default; judgment calls are flagged for a human to eyeball.
cmd_migrate_status() {
  run_lint_py migrate --root . "$@"
}

cmd_lint() {
  run_lint_py lint --root . --cli-version "$VERSION" "$@"
}

cmd_version() {
  echo "codepress v$VERSION"
  if [[ -d ".codepress/system" ]]; then
    echo "project marker: v$(get_codepress_version)  ($(resolve_config))"
  fi
}

cmd_galley() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    new) cmd_galley_new "$@" ;;
    list) cmd_galley_list "$@" ;;
    move) cmd_galley_move "$@" ;;
    approve) cmd_galley_approve "$@" ;;
    *) echo "Usage: codepress galley new|list|move|approve"; exit 1 ;;
  esac
}

# ─── Git hook (lint + verify gates, no --no-verify) ───────────────────────────
#
# `codepress hook install` writes a pre-commit shim; the shim calls
# `codepress hook run`, which is where the logic (and its tests) live.
#
# A fresh git worktree has no virtualenv of its own, so the gates would fail
# with "command not found" and tempt people into --no-verify. Instead the hook
# finds a tool environment, in this order:
#   1. CODEPRESS_ENV=<dir>            explicit (a venv root with bin/)
#   2. hook-env: in codepress.md      absolute, or relative to this/the main worktree
#   3. ./.venv ./venv ./env           the worktree's own
#   4. the same names in the main worktree (git's common dir)
# CODEPRESS_HOOK_GATES="lint"        narrows the gates for one commit (default
#                                    "lint test") — the sanctioned alternative to
#                                    --no-verify when an environment is truly absent.

hook_find_env() {
  local d cand main_root common cfg_env
  if [[ -n "${CODEPRESS_ENV:-}" ]]; then
    if [[ -d "$CODEPRESS_ENV" ]]; then echo "$CODEPRESS_ENV"; return 0; fi
    echo "✗ CODEPRESS_ENV=$CODEPRESS_ENV is not a directory." >&2
    return 1
  fi

  main_root=""
  common=$(git rev-parse --git-common-dir 2>/dev/null || true)
  if [[ -n "$common" ]]; then
    main_root=$(cd "$common/.." 2>/dev/null && pwd || true)
  fi

  cfg_env=""
  if [[ -f "$(resolve_config)" ]]; then
    cfg_env=$(grep -m1 '^hook-env:' "$(resolve_config)" 2>/dev/null | sed 's/^hook-env:[ ]*//; s/[ \t]*#.*$//; s/[ \t]*$//' || true)
  fi
  if [[ -n "$cfg_env" ]]; then
    for cand in "$cfg_env" "$PWD/$cfg_env" "${main_root:+$main_root/$cfg_env}"; do
      [[ -n "$cand" && -d "$cand" ]] && { echo "$cand"; return 0; }
    done
  fi

  for d in .venv venv env; do
    [[ -f "$PWD/$d/bin/activate" || -x "$PWD/$d/bin/python" ]] && { echo "$PWD/$d"; return 0; }
  done
  if [[ -n "$main_root" && "$main_root" != "$PWD" ]]; then
    for d in .venv venv env; do
      [[ -f "$main_root/$d/bin/activate" || -x "$main_root/$d/bin/python" ]] && { echo "$main_root/$d"; return 0; }
    done
  fi
  return 0
}

cmd_hook_run() {
  local env_dir gates gate cmd rc out fails=0 ran=""
  env_dir=$(hook_find_env) || exit 1
  if [[ -n "$env_dir" ]]; then
    export VIRTUAL_ENV="$env_dir"
    export PATH="$env_dir/bin:$PATH"
    unset PYTHONHOME || true
  fi

  gates="${CODEPRESS_HOOK_GATES:-lint test}"
  echo "codepress hook — gates: $gates${env_dir:+  (env: $env_dir)}"

  for gate in $gates; do
    if [[ "$gate" == "lint" ]]; then
      if out=$(cmd_lint --quiet 2>&1); then
        echo "  ✅ lint"
      else
        echo "  ❌ lint"
        echo "$out" | sed 's/^/       /'
        fails=$((fails + 1))
      fi
      continue
    fi
    cmd=$(get_gate_command "$gate")
    if [[ -z "$cmd" ]]; then
      echo "  ⚠️  $gate — no command in $(resolve_config); skipped"
      continue
    fi
    set +e
    out=$(bash -c "$cmd" 2>&1)
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
      echo "  ✅ $gate — $cmd"
    elif [[ "$rc" -eq 127 ]]; then
      echo "  ❌ $gate — command not found: $cmd"
      echo "       No tool environment was found for this checkout. Point the hook at one:"
      echo "         CODEPRESS_ENV=/path/to/venv git commit ...      (or set hook-env: in codepress.md)"
      echo "       To run only lint for this one commit:"
      echo "         CODEPRESS_HOOK_GATES=lint git commit ..."
      fails=$((fails + 1))
    else
      echo "  ❌ $gate — $cmd (exit $rc)"
      echo "$out" | tail -15 | sed 's/^/       /'
      fails=$((fails + 1))
    fi
  done

  if [[ "$fails" -gt 0 ]]; then
    echo "✗ hook failed ($fails gate(s))."
    return 1
  fi
  echo "✓ hook passed."
}

cmd_hook_install() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "✗ Not a git repository."
    exit 1
  fi
  local hooks_dir hp
  hp=$(git config core.hooksPath 2>/dev/null || true)
  if [[ -n "$hp" ]]; then
    case "$hp" in /*) hooks_dir="$hp" ;; *) hooks_dir="$(git rev-parse --show-toplevel)/$hp" ;; esac
  else
    hooks_dir=$(git rev-parse --git-path hooks)
    case "$hooks_dir" in /*) ;; *) hooks_dir="$PWD/$hooks_dir" ;; esac
  fi
  mkdir -p "$hooks_dir"
  local target="$hooks_dir/pre-commit"
  if [[ -f "$target" ]] && ! grep -q "codepress-managed" "$target" && [[ "$force" != true ]]; then
    echo "✗ $target already exists and is not codepress-managed. Use --force to replace it."
    exit 1
  fi
  cat > "$target" <<SHIM
#!/usr/bin/env bash
# codepress-managed pre-commit hook (installed by 'codepress hook install').
# Runs lint + the verify gates. Environment: CODEPRESS_ENV=<venv dir>,
# CODEPRESS_HOOK_GATES="lint test". Never needs --no-verify.
CP="\${CODEPRESS_BIN:-$SCRIPT_DIR/codepress}"
[ -x "\$CP" ] || CP="\$(command -v codepress || true)"
[ -n "\$CP" ] || { echo "codepress: CLI not found — set CODEPRESS_BIN" >&2; exit 1; }
exec "\$CP" hook run "\$@"
SHIM
  chmod +x "$target"
  echo "✓ Installed pre-commit hook at $target"
}

cmd_hook_uninstall() {
  local hooks_dir target
  hooks_dir=$(git rev-parse --git-path hooks 2>/dev/null || true)
  case "$hooks_dir" in /*) ;; *) hooks_dir="$PWD/$hooks_dir" ;; esac
  target="$hooks_dir/pre-commit"
  if [[ -f "$target" ]] && grep -q "codepress-managed" "$target"; then
    rm -f "$target"
    echo "✓ Removed $target"
  else
    echo "  (no codepress-managed pre-commit hook found)"
  fi
}

cmd_hook() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    run) cmd_hook_run "$@" ;;
    install) cmd_hook_install "$@" ;;
    uninstall) cmd_hook_uninstall "$@" ;;
    *) echo "Usage: codepress hook install|uninstall|run"; exit 1 ;;
  esac
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  init) cmd_init ;;
  bootstrap) cmd_bootstrap ;;
  upgrade) cmd_upgrade ;;
  migrate) cmd_migrate ;;
  status) shift; cmd_status "$@" ;;
  run) shift; cmd_run "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  galley) shift; cmd_galley "$@" ;;
  check) shift; cmd_check "$@" ;;
  lint) shift; cmd_lint "$@" ;;
  migrate-status) shift; cmd_migrate_status "$@" ;;
  hook) shift; cmd_hook "$@" ;;
  version|-v|--version) cmd_version ;;
  __extract-acs) shift; extract_acs "$@" ;;  # internal plumbing (used by tests)
  -h|--help|"") usage ;;
  *) echo "Unknown: $1"; usage; exit 1 ;;
esac
